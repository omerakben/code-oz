{
  "name": "code-oz",
  "version": "0.18.0-alpha.0",
  "description": "Multi-agent software-company simulation CLI with hard SDLC gates",
  "type": "module",
  "main": "src/cli.ts",
  "module": "src/cli.ts",
  "bin": {
    "code-oz": "./dist/code-oz"
  },
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "dev": "bun run src/cli.ts",
    "build:binary": "bun build --compile --target=bun src/cli.ts --outfile dist/code-oz",
    "build:binaries": "bun run scripts/build-binaries.ts",
    "smoke": "bun run scripts/smoke-test.ts",
    "typecheck": "tsc --noEmit",
    "eval:repo_context": "bun run scripts/eval-repo-context.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "license": "MIT",
  "author": "Omer Akben (Ozzy)",
  "repository": {
    "type": "git",
    "url": "https://github.com/omerakben/code-oz.git"
  },
  "homepage": "https://github.com/omerakben/code-oz",
  "bugs": "https://github.com/omerakben/code-oz/issues",
  "keywords": [
    "ai",
    "agents",
    "claude",
    "codex",
    "gemini",
    "sdlc",
    "orchestrator",
    "multi-agent",
    "cli"
  ],
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "yaml": "^2.6.1"
  }
}
